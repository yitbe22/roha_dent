# Supabase Edge Function secrets.
#   Local:      copy to supabase/functions/.env  (git-ignored)
#   Production: supabase secrets set --env-file ./supabase/functions/.env
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# --- SMS Ethiopia (https://smsethiopia.com/#/landing/docs/api-v1) ---
SMSETHIOPIA_API_KEY=            # 40-char key from Console → API Keys (campaign-scoped)
SMSETHIOPIA_BASE_URL=https://smsethiopia.com
SMS_DRY_RUN=true                # true = log to sms_log as dry_run, never call the provider
SMS_WEBHOOK_SECRET=             # random string; put in the webhook URL given to SMS Ethiopia support
SMS_WORKER_SECRET=              # random string; must match Vault secret "sms_worker_secret" (see README)

# --- Cloudflare Turnstile (server-side verification) ---
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA   # Cloudflare's always-pass test key

# --- Public site ---
PUBLIC_SITE_URL=http://localhost:5173   # used to build {manage_link}
ALLOWED_ORIGINS=http://localhost:5173,https://rohadent.com,https://www.rohadent.com
